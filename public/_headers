# Consignes de cache pour Cloudflare Pages.
# Les pages HTML sont toujours revérifiées : chaque visiteur voit la dernière version.
/*
  Cache-Control: public, max-age=0, must-revalidate

# Les fichiers techniques de Next.js ont un nom unique à chaque version : on peut les garder longtemps.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Photos et gravures : gardées 1 jour, puis revérifiées.
/images/*
  Cache-Control: public, max-age=86400, must-revalidate
